# Server-only Supabase credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret used by the iPhone Shortcut to call POST /api/transactions.
TRANSACTIONS_API_KEY=replace-with-a-long-random-secret

# Server-only Google Apps Script webhook used to mirror newly created transactions.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
